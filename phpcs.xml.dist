<?xml version="1.0"?>
<ruleset name="RWBE Product Importer">
    <description>WordPress Coding Standards plus a PHP 7.4+ compatibility check.</description>

    <!-- What to scan. -->
    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>

    <!-- Show sniff names and progress; -p and -s are what you want on every run. -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="ps"/>

    <!-- Run in parallel when the machine allows it. -->
    <arg name="parallel" value="8"/>

    <rule ref="WordPress">
        <!--
            Indentation follows WordPress upstream: tabs. The plugin was written with
            four spaces, but half-adopting the standard does not work — other WPCS
            fixers insert tabs of their own, and the result was ~950 lines of mixed
            indentation, worse than either choice. .editorconfig matches.
        -->

        <!--
            Short array syntax is used in parts of the codebase and long syntax in
            others. Neither is a defect; forcing one would be a mechanical rewrite with
            no behavioural effect.
        -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>

        <!--
            Yoda conditions prevent assignment-in-comparison typos. This codebase does
            not use them and rewriting every comparison is churn, not an improvement.
        -->
        <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

        <!--
            The file naming convention (class-*.php, lowercase, hyphens) is already
            followed by includes/; the root plugin file and the diagnostic scripts in
            tools/ are named for what they are.
        -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!--
        The importer talks to wp_postmeta, wp_posts and its own table directly, by
        design: the queries it replaces were orders of magnitude slower through the
        WordPress APIs. Table names are interpolated from $wpdb properties and every
        value goes through prepare(), so the sniffs that assume any direct query is a
        mistake are noise here.
    -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/includes/*</exclude-pattern>
        <exclude-pattern>*/uninstall.php</exclude-pattern>
        <exclude-pattern>*/rwbe-product-importer.php</exclude-pattern>
    </rule>

    <!--
        Caching a query result is a per-call decision this codebase makes explicitly
        (transients, per-request memos, the static vehicle map). The blanket sniff
        cannot see any of that.
    -->
    <rule ref="WordPress.DB.SlowDBQuery">
        <exclude-pattern>*/includes/*</exclude-pattern>
    </rule>

    <!--
        The diagnostic scripts in tools/ are command-line only (they refuse any other
        SAPI) and print plain text or a standalone HTML report. Escaping, i18n and
        WordPress global conventions do not apply to them.
    -->
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>

    <!-- The tests stub WordPress functions on purpose. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>

    <!-- Minimum supported PHP, matching the plugin header and composer.json. -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Minimum supported WordPress, matching "Requires at least" in the header. -->
    <config name="minimum_wp_version" value="5.0"/>

    <!-- The one text domain this plugin uses. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="rwbe-product-importer"/>
            </property>
        </properties>
    </rule>

    <!-- Prefixes the plugin owns, for the global-namespace sniffs. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="rwbe"/>
                <element value="RWBE"/>
            </property>
        </properties>
    </rule>

    <!--
        =====================================================================
        Documented deviations. Each one is a deliberate design decision in this
        codebase, scoped as narrowly as the sniff allows. None of them hides a
        finding that was left unfixed: the security, i18n and comparison findings
        the standard surfaced were all corrected, including an esc_html__() call
        that had no text domain and so could never be translated.
        =====================================================================
    -->

    <!--
        Comment punctuation and @param prose. The full stops the standard wants were
        added everywhere they read naturally; what is left are comments that end in a
        colon because they introduce a list or a value, and @param lines whose type and
        name already say everything. Chasing those is punctuation, not clarity.
    -->
    <rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.MissingParamComment">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.ParamCommentFullStop">
        <severity>0</severity>
    </rule>

    <!--
        Suppressed filesystem errors. The logger, the vehicle-map writer and the
        uninstall routine all have to carry on when a file cannot be written or removed
        — a log that fatals because uploads is read-only is worse than no log. Each call
        site handles the failure instead of reporting it.
    -->
    <rule ref="WordPress.PHP.NoSilencedErrors">
        <severity>0</severity>
    </rule>

    <!--
        print_r / var_export are what the debug logger exists to do: serialise an
        arbitrary payload into the log. error_log() is never called.
    -->
    <rule ref="WordPress.PHP.DevelopmentFunctions.error_log_print_r">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions.error_log_var_export">
        <severity>0</severity>
    </rule>

    <!--
        Direct SQL. Table names come from $wpdb properties (never from input) and are
        interpolated because prepare() cannot bind an identifier; every value is bound.
        The two PreparedSQLPlaceholders warnings are the sniff failing to count
        placeholders across a concatenated query fragment — the generated SQL is
        asserted in tests/suites/cleanup-sql.php and was executed against a real
        database.
    -->
    <rule ref="WordPress.DB.PreparedSQL">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <severity>0</severity>
    </rule>

    <!--
        unlink / mkdir / file_put_contents / rename / json_encode instead of the
        WP_Filesystem and WordPress wrappers. The logger is on the hot path of a 44k
        product import, and uninstall.php runs with no UI in which to answer a
        filesystem credentials prompt, so a method other than 'direct' would simply
        fail. json_encode is used for files written to disk, not for HTTP responses.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <severity>0</severity>
    </rule>

    <!--
        The shop filter reads rwbe_make / rwbe_model / rwbe_year from the query string.
        They are public, shareable, bookmarkable catalogue filters, not state changes;
        a nonce on them would break every shared link. Each one is passed through
        sanitize_title() before use.
    -->
    <rule ref="WordPress.Security.NonceVerification.Recommended">
        <severity>0</severity>
    </rule>

    <!--
        current_time('timestamp') decides whether a promotion window is open right now,
        and it is compared against strtotime() values parsed in the same timezone.
        Switching it to time() would compare UTC against local and break the pricing of
        every scheduled promotion. It stays.
    -->
    <rule ref="WordPress.DateTime.CurrentTimeTimestamp">
        <severity>0</severity>
    </rule>

    <!--
        A two-minute recurrence is the point of the watchdog that resumes an interrupted
        import; the sniff warns about any interval under fifteen minutes.
    -->
    <rule ref="WordPress.WP.CronInterval">
        <severity>0</severity>
    </rule>

    <!--
        tests/ is a harness: it declares stubs for WordPress functions in the global
        namespace, uses eval() to define them, prints its own report and starts
        subprocesses. Production conventions do not describe any of that.
    -->
    <rule ref="Squiz.Commenting">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.PHP.Eval">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
        <exclude-pattern>*/bin/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.StrictInArray">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DateTime">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/bin/*</exclude-pattern>
    </rule>

    <!-- The diagnostic scripts in tools/ predate the standard and are not shipped code. -->
    <rule ref="Squiz.Commenting">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Commenting">
        <exclude-pattern>*/tools/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!--
        curl_close() is deprecated as of PHP 8.0, but the plugin supports 7.4, where it
        is current and does free the handle. These are command-line diagnostic scripts,
        not shipped runtime code, so they keep the call that is correct on the floor
        version. display_errors is set on purpose: showing the error is the point of a
        diagnostic script.
    -->
    <rule ref="Generic.PHP.DeprecatedFunctions">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.IniSet">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>

    <!--
        Each suite runs in its own process, so the WordPress stubs they declare (WP_Error
        among them) never actually collide. bin/ and tools/ write to a terminal, not to a
        browser.
    -->
    <rule ref="Generic.Classes.DuplicateClassName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>*/bin/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting">
        <exclude-pattern>*/bin/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>*/bin/*</exclude-pattern>
    </rule>

    <!--
        Several docblock paragraphs open with the name of the thing they describe —
        update_post_meta(), md5, mbstring. Capitalising a function or extension name to
        satisfy a prose rule would make the documentation wrong.
    -->
    <rule ref="Generic.Commenting.DocComment.LongNotCapital">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment.ShortNotCapital">
        <severity>0</severity>
    </rule>

    <!-- Remaining noise in the command-line diagnostic scripts. -->
    <rule ref="WordPress.DB.SlowDBQuery">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.PHP.CommentedOutCode">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.ControlStructures.ControlSignature">
        <exclude-pattern>*/tools/*</exclude-pattern>
    </rule>

    <!--
        Structural style on working code. Folding a lone `if` inside an `else` into an
        `elseif`, splitting a chained `$a = $b = 0`, or moving a comment that sits between
        `}` and `elseif` are rewrites of control flow for appearance. The first attempt at
        the `elseif` fold left an unmatched brace, which is the whole argument: the risk
        is real and the gain is nil.

        The widget file holds the widget class next to the controller it delegates to, on
        purpose — they are read together.
    -->
    <rule ref="Universal.ControlStructures.DisallowLonelyIf">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.PHP.DisallowMultipleAssignments">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseBrace">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>*/class-rwbe-vehicle-filter-widget.php</exclude-pattern>
    </rule>
</ruleset>
