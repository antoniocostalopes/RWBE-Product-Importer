# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress upstream uses tabs; this plugin is four-space indented throughout and
# phpcs.xml.dist excludes the tab sniff to match. Keep editors in step with that.
[*.{php,js,css}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,dist}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{txt,po,pot}]
insert_final_newline = false
