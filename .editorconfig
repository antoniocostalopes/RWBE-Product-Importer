# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Tabs, following WordPress upstream and phpcs.xml.dist. indent_size only tells the
# editor how wide to render a tab; it does not turn it into spaces.
[*.{php,js,css}]
indent_style = tab
indent_size = 4

[*.{json,yml,yaml,xml,dist}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{txt,po,pot}]
insert_final_newline = false
